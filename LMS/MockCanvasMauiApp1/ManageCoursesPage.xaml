<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.ManageCoursesPage"
             Title="Manage Courses">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Courses"
               FontSize="24"
               HorizontalOptions="Center" />

        <ListView x:Name="CoursesListView"
          ItemTapped="OnCourseTapped">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button Text="Create Course"
                Clicked="OnCreateCourseClicked"/>

        <Button Text="Export Roster"
                Clicked="OnExportRosterClicked"/>

        <Button Text="Import Roster"
                Clicked="OnImportRosterClicked"/>

        <Button Text="Manage Roster"
                Clicked="OnManageRosterClicked"/>

    </VerticalStackLayout>

</ContentPage>