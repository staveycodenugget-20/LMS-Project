<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.ModulesPage"
             Title="Modules">

    <VerticalStackLayout Padding="20">

        <Label Text="Modules"
               FontSize="24"
               HorizontalOptions="Center" />

        <ListView x:Name="ModulesListView"
                  ItemTapped="OnModuleTapped">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button x:Name="AddModuleBtn"
                  Text="Add Module"
                  Clicked="OnAddModuleClicked"/>

        <Button x:Name="EditModuleBtn"
                  Text="Edit Module"
                  Clicked="OnEditModuleClicked"/>

        <Button x:Name="DeleteModuleBtn"
                  Text="Delete Module"
                  Clicked="OnDeleteModuleClicked"/>

        <Button x:Name="ManageContentBtn"
                  Text="Manage Content"
                  Clicked="OnManageContentClicked"/>

    </VerticalStackLayout>

</ContentPage>