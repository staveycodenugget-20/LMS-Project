<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.TeacherCourseRosterPage"
             Title="Course Roster">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Course Roster"
               FontSize="24"
               HorizontalOptions="Center" />

        <ListView x:Name="RosterListView"
                  ItemSelected="OnStudentSelected" />

        <Button Text="Add Student"
                Clicked="OnAddStudentClicked"/>

        <Button Text="Remove Selected Student"
                Clicked="OnRemoveStudentClicked"/>

    </VerticalStackLayout>

</ContentPage>