<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.CourseDetailsPage"
             Title="Course">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="CourseNameLabel"
               FontSize="24"
               HorizontalOptions="Center" />

        <Button Text="View Modules"
                Clicked="OnModulesClicked"/>

        <Button Text="View Assignments"
                Clicked="OnAssignmentsClicked"/>

        <Button Text="View Grades"
                Clicked="OnGradesClicked"/>

    </VerticalStackLayout>

</ContentPage>