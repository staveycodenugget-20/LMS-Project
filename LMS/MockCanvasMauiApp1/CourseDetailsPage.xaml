<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.CourseDetailsPage"
             Title="Course">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="CourseNameLabel"
               FontSize="24"
               HorizontalOptions="Center" />

        <Label x:Name="FinalGradeLabel"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Green" />

        <Button Text="View Modules"
                Clicked="OnModulesClicked"/>

        <Button Text="View Assignments"
                Clicked="OnAssignmentsClicked"/>

        <Button Text="View Grades"
                Clicked="OnGradesClicked"/>
        
        <Label Text="Roster Management"
               FontSize="20"
               FontAttributes="Bold"
               Margin="0,20,0,0"/>

        <ListView x:Name="RosterListView"
                  ItemSelected="OnStudentSelected"
                  HeightRequest="150">
        </ListView>

        <Button Text="Add Student"
                Clicked="OnAddStudentClicked"/>

        <Button Text="Remove Selected Student"
                Clicked="OnRemoveStudentClicked"/>

    </VerticalStackLayout>

</ContentPage>