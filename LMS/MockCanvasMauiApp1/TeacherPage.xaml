<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.TeacherPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Teacher Menu"
               FontSize="28"
               HorizontalOptions="Center" />

        <Button Text="Manage Courses"
                Clicked="OnManageCoursesClicked"/>

        <Button Text="Manage Assignments"
                Clicked="OnManageAssignmentsClicked"/>

        <Button Text="Manage Modules"
                Clicked="OnManageModulesClicked"/>

        <!--<Button Text="View Students"
                Clicked="OnViewStudentsClicked"/>-->
        
        <Button Text="Manage Students"
                Clicked="OnManageStudentsClicked"/>

    </VerticalStackLayout>

</ContentPage>