<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.ManageStudentsPage"
             Title="Manage Students">

    <VerticalStackLayout Padding="20" Spacing="10">

        <ListView x:Name="StudentsListView"
          ItemTapped="OnStudentTapped">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button Text="Add Student"
                Clicked="OnAddStudent"/>

        <Button Text="Edit Student"
                Clicked="OnEditStudent"/>

        <Button Text="Remove Student"
                Clicked="OnRemoveStudent"/>

    </VerticalStackLayout>

</ContentPage>