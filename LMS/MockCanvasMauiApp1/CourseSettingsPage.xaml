<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MockCanvasMauiApp1.CourseSettingsPage"
             Title="Course Settings">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Grade Cutoffs"
               FontSize="24"
               HorizontalOptions="Center"/>

        <Entry x:Name="AEntry" Placeholder="A cutoff"/>
        <Entry x:Name="BEntry" Placeholder="B cutoff"/>
        <Entry x:Name="CEntry" Placeholder="C cutoff"/>
        <Entry x:Name="DEntry" Placeholder="D cutoff"/>

        <Button Text="Save"
                Clicked="OnSaveClicked"/>

    </VerticalStackLayout>

</ContentPage>